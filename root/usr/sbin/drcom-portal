#!/bin/sh
# Dr.COM ePortal (城市热点) 网页认证客户端
#
# 用于让路由器代替接入设备完成校园网 Portal 认证。
# 用法: drcom-portal {online|offline|login|status|watch|wake|idle}

. /lib/functions.sh

# 状态目录里有账号等信息，统一收紧权限
umask 077

STATE_DIR=/var/run/drcom
PAUSE_FILE=/etc/drcom.paused	# 手动下线标记：放 /etc 才能跨重启保留
HOLD_FILE="$STATE_DIR/hold"	# 连续失败过多后暂停自动重试
FAIL_FILE="$STATE_DIR/fails"
ERR_FILE="$STATE_DIR/last_error"
PID_FILE="$STATE_DIR/watch.pid"
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# 日志分类：自动认证（守护循环）与手动操作分开，界面可切换查看
LOG_TAG="[操作]"
MIRROR_SYSLOG=1

# 本固件自带的 wget 可能没有 -i（GNU 独有）。有就用 -i 从文件读 URL
# （避免密码出现在 /proc/<pid>/cmdline），没有就退回直接把 URL 传给 wget。
# 注意统一用 -T（GNU 与 BusyBox 都支持）而不是 --timeout。
WGET_INPUT_FILE=0
detect_wget() {
	wget --help 2>&1 | grep -q 'input-file' && WGET_INPUT_FILE=1
	return 0
}

# fetch_url <url> <输出文件> <超时秒>
fetch_url() {
	local _url="$1" _out="$2" _to="$3" _uf="$STATE_DIR/login.url"
	if [ "$WGET_INPUT_FILE" = "1" ]; then
		printf '%s\n' "$_url" > "$_uf"
		wget -q -i "$_uf" -O "$_out" -T "$_to" -U "$UA" 2>/dev/null
		rm -f "$_uf"
	else
		wget -q -O "$_out" -T "$_to" -U "$UA" "$_url" 2>/dev/null
	fi
}

log() {
	printf '%s %s %s\n' "$(date '+%F %T')" "$LOG_TAG" "$*"
	# 守护循环由 procd 收集 stdout 进 syslog；手动操作（界面按钮 / 命令行）没有这层，
	# 需要自己写一条，否则操作日志在界面上根本看不到。
	[ "$MIRROR_SYSLOG" = "1" ] && logger -t drcom-portal "$LOG_TAG $*" 2>/dev/null
}
err() {
	printf '%s %s ERROR: %s\n' "$(date '+%F %T')" "$LOG_TAG" "$*" >&2
	[ "$MIRROR_SYSLOG" = "1" ] && logger -t drcom-portal "$LOG_TAG ERROR: $*" 2>/dev/null
}

load_config() {
	config_load drcom
	config_get_bool ENABLED         main enabled            1
	config_get      USERNAME        main username           ""
	config_get      PASSWORD        main password           ""
	config_get      CARRIER         main carrier            ""
	config_get      PORTAL_HOST     main portal_host "login.cqcfe.com"
	config_get      PORTAL_IP       main portal_ip   "172.22.44.46"
	config_get      PORTAL_PORT     main portal_port        "801"
	config_get      UPLINK          main uplink             "auto"
	config_get      TERMINAL_TYPE   main terminal_type      "1"
	config_get      CHECK_INTERVAL  main check_interval     "60"
	config_get      RETRY_INTERVAL  main retry_interval     "20"
	config_get      RETRY_MAX       main retry_max_interval "300"
	config_get      FAIL_MAX        main fail_max           "5"
	config_get      PROBE_URL       main probe_url "http://www.msftconnecttest.com/connecttest.txt"
	config_get      PROBE_EXPECT    main probe_expect "Microsoft Connect Test"
	# 账号已自带运营商后缀时不要重复拼（例如账号写成 xx@dx 又选了电信）
	ACCOUNT="$USERNAME"
	if [ -n "$CARRIER" ]; then
		case "$USERNAME" in
			*"$CARRIER") : ;;
			*) ACCOUNT="$USERNAME$CARRIER" ;;
		esac
	fi
	# 0-未知 1-PC 2-手机 3-平板(横屏) 4-平板(竖屏)，决定上报的终端类型
	case "$TERMINAL_TYPE" in
		0|1|2|3|4) ;;
		*) TERMINAL_TYPE=1 ;;
	esac
	# 兜底校验：防止手改配置写成 0/非数字，让 sleep 变成紧循环
	[ "$CHECK_INTERVAL" -ge 10 ] 2>/dev/null || CHECK_INTERVAL=10
	[ "$RETRY_INTERVAL" -ge 5 ] 2>/dev/null || RETRY_INTERVAL=5
	[ "$FAIL_MAX" -ge 1 ] 2>/dev/null || FAIL_MAX=5
	[ "$RETRY_MAX" -ge "$RETRY_INTERVAL" ] 2>/dev/null || RETRY_MAX=300
}

# 可被信号打断的睡眠。
# 前台 sleep 会让 ash 推迟执行 trap，procd 的 term_timeout(5s) 一到就直接 SIGKILL，
# 于是 trap 里的「服务停止」和状态刷新全都不会发生（实测过）。
sleep_pid=""
do_sleep() {
	sleep "$1" &
	sleep_pid=$!
	wait "$sleep_pid" 2>/dev/null
	kill "$sleep_pid" 2>/dev/null
	wait "$sleep_pid" 2>/dev/null
	sleep_pid=""
}

# 状态文件会被 rpcd 用 sh 的 "." 读进来，值必须干净：去掉引号、换行、控制字符并限长
sanitize() {
	printf '%s' "$1" | tr -d '\r\n\t' | tr -d "'" | cut -c1-120
}

get_fails() {
	local n
	n=$(cat "$FAIL_FILE" 2>/dev/null)
	case "$n" in
		''|*[!0-9]*) n=0 ;;
	esac
	printf '%s' "$n"
}

clear_fails() { rm -f "$FAIL_FILE" "$HOLD_FILE" 2>/dev/null; }

bump_fail() {
	local n
	n=$(get_fails)
	n=$((n + 1))
	mkdir -p "$STATE_DIR" 2>/dev/null
	printf '%s' "$n" > "$FAIL_FILE"
	if [ "$n" -ge "$FAIL_MAX" ] && [ ! -f "$HOLD_FILE" ]; then
		: > "$HOLD_FILE"
		log "连续认证失败 $n 次，已暂停自动重试；请检查账号后在界面点「立即重新认证」重试"
	fi
}

# 指数退避：retry_interval × 2^(n-1)，上限 retry_max_interval
backoff_delay() {
	local n d
	n=$(get_fails)
	[ "$n" -ge 1 ] 2>/dev/null || n=1
	[ "$n" -gt 6 ] && n=6
	d=$(( RETRY_INTERVAL * (1 << (n - 1)) ))
	[ "$d" -gt "$RETRY_MAX" ] 2>/dev/null && d=$RETRY_MAX
	printf '%s' "$d"
}

set_error() { mkdir -p "$STATE_DIR" 2>/dev/null; printf '%s' "$(sanitize "$1")" > "$ERR_FILE"; }
clear_error() { rm -f "$ERR_FILE" 2>/dev/null; }

# 写入状态快照供 LuCI 界面秒读，避免每次开页面都要等探测超时
save_state() {
	mkdir -p "$STATE_DIR" 2>/dev/null
	chmod 700 "$STATE_DIR" 2>/dev/null
	{
		printf 'online=%s\n' "$1"
		printf "ip='%s'\n"      "$(sanitize "$2")"
		printf "uplink='%s'\n"  "$(sanitize "$3")"
		printf "account='%s'\n" "$(sanitize "$ACCOUNT")"
		printf 'paused=%s\n' "$( [ -f "$PAUSE_FILE" ] && echo 1 || echo 0 )"
		printf 'hold=%s\n'   "$( [ -f "$HOLD_FILE" ] && echo 1 || echo 0 )"
		printf 'fails=%s\n'  "$(get_fails)"
		printf "last_error='%s'\n" "$(sanitize "$(cat "$ERR_FILE" 2>/dev/null)")"
		printf 'stamp=%s\n'  "$(date +%s)"
	} > "$STATE_DIR/state.tmp" 2>/dev/null
	mv "$STATE_DIR/state.tmp" "$STATE_DIR/state" 2>/dev/null
	chmod 600 "$STATE_DIR"/* 2>/dev/null
}

urlencode() {
	local s="$1" out="" c i=0 n=${#1}
	while [ $i -lt $n ]; do
		c=${s:$i:1}
		case "$c" in
			[A-Za-z0-9._~-]) out="$out$c" ;;
			*) out="$out$(printf '%%%02X' "'$c")" ;;
		esac
		i=$((i+1))
	done
	printf '%s' "$out"
}

iface_ip() {
	ubus call network.interface."$1" status 2>/dev/null | \
		jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
}

iface_up() {
	[ "$(ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)" = "true" ]
}

# 取该接口 netifd 认为的默认网关。只有 netifd 确实认为该接口「有默认路由」时才返回，
# 免得用户特意配置「不带默认路由」的上行时被我们擅自加一条。
# 谓词写法要较新的 jsonfilter 才支持，老版本退回按 index 取，并校验第一条确实指向 0.0.0.0。
iface_gateway() {
	local n pair t
	n=$(ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null)
	if [ -z "$n" ]; then
		pair=$(ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.route[0].target' -e '@.route[0].nexthop' 2>/dev/null)
		t=$(printf '%s\n' "$pair" | head -1)
		[ "$t" = "0.0.0.0" ] && n=$(printf '%s\n' "$pair" | tail -1)
	fi
	printf '%s' "$n"
}

# 逻辑接口对应的内核设备名（例如 wwan -> phy1-sta0）。ip route 必须用物理设备名。
iface_l3dev() {
	ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null
}

# netifd 与内核路由表偶发不同步，典型场景：插过 USB / CPE 上行并由它提供默认路由，
# 拔掉之后 netifd 仍以为 wwan 的默认路由还在，内核里那条却被删了。结果是接口有 IP、
# 却完全上不了外网，插件会一直报「认证服务器无响应」。这里在内核确实没有默认路由时，
# 按 netifd 已知网关补一条（不重启接口，避免扰动共用射频的 AP / 无线）。
ensure_default_route() {
	local up="$1" gw dev
	ip route 2>/dev/null | grep -q '^default ' && return 0
	gw=$(iface_gateway "$up")
	[ -n "$gw" ] || return 1
	dev=$(iface_l3dev "$up")
	[ -n "$dev" ] || return 1
	ip route replace default via "$gw" dev "$dev" 2>/dev/null || return 1
	log "上行 $up 有 IP 但内核缺少默认路由（netifd 不同步），已补上：default via $gw dev $dev"
	return 0
}

# auto: 优先无线中继(wwan)，其次有线(wan)，取第一个拿到 IP 的；
# 都没有 IP 时退回第一个「接口已 up」的，避免 ifdown/ifup 打到无关/不存在的接口。
resolve_uplink() {
	case "$UPLINK" in
		""|auto)
			local ifc
			for ifc in wwan wan; do
				[ -n "$(iface_ip $ifc)" ] && { echo "$ifc"; return 0; }
			done
			for ifc in wwan wan; do
				iface_up "$ifc" && { echo "$ifc"; return 0; }
			done
			echo wwan
			;;
		*) echo "$UPLINK" ;;
	esac
}

# 认证服务器地址：优先用上次探测结果，其次从认证页取 v4serip。
# 注意：只有真的从认证页解析出地址时才写缓存；用兜底值时不留缓存，
# 这样门户页偶尔打不开不会把兜底 IP 永久固化，学校换地址后下一轮还能重探。
portal_server() {
	local cached="$STATE_DIR/server" page="$STATE_DIR/page.htm" ser=""
	[ -s "$cached" ] && { cat "$cached"; return 0; }

	wget -q -O "$page" -T 8 -U "$UA" \
		"http://$PORTAL_HOST/a79.htm?url=http://www.msftconnecttest.com/redirect" 2>/dev/null
	if [ -s "$page" ]; then
		ser=$(grep -o "v4serip=[^;]*" "$page" 2>/dev/null | head -1 | cut -d= -f2 | tr -d "'\" ")
	fi
	rm -f "$page"

	if [ -n "$ser" ]; then
		mkdir -p "$STATE_DIR" 2>/dev/null
		printf '%s\n' "$ser" > "$cached"
		chmod 600 "$cached" 2>/dev/null
		printf '%s' "$ser"
	else
		printf '%s' "$PORTAL_IP"
	fi
}

# 只读缓存/配置里的认证服务器，不发任何网络请求（供 status 等诊断命令用）
server_cached() {
	local cached="$STATE_DIR/server"
	if [ -s "$cached" ]; then cat "$cached"; else printf '%s' "$PORTAL_IP"; fi
}

# 未认证时该地址会被劫持到认证页，只有真正通了才会返回预期内容。
# 可选参数：超时秒数（默认 8；诊断命令用更短的超时，避免长时间卡住）。
probe_online() {
	local to="${1:-8}" body
	body=$(wget -q -O - -T "$to" "$PROBE_URL" 2>/dev/null | tr -d '\r\n')
	[ "$body" = "$PROBE_EXPECT" ]
}

do_login() {
	[ -n "$ACCOUNT" ] && [ -n "$PASSWORD" ] || { err "账号或密码未配置"; return 2; }

	local up ip ser resp url msg
	up=$(resolve_uplink)
	ip=$(iface_ip "$up")
	[ -z "$ip" ] && { err "上行接口 $up 未获取到 IP，暂不认证"; return 3; }

	ser=$(portal_server)
	mkdir -p "$STATE_DIR" 2>/dev/null
	resp="$STATE_DIR/login.json"

	# 带上 wlan_user_ip：部分 ePortal 4.x 部署会校验它，缺了会报「IP 不一致」
	url="http://$ser:$PORTAL_PORT/eportal/portal/login?callback=dr1003&login_method=1&user_account=,0,$(urlencode "$ACCOUNT")&user_password=$(urlencode "$PASSWORD")&wlan_user_ip=$ip&wlan_user_ipv6=&wlan_user_mac=000000000000&wlan_ac_ip=&wlan_ac_name=&jsVersion=4.1.3&terminal_type=$TERMINAL_TYPE&lang=zh-cn&v=$(date +%s)"

	# 有 -i 就由文件读（密码不进命令行），没有就直接传 URL（兼容 BusyBox wget）
	fetch_url "$url" "$resp" 12

	if [ ! -s "$resp" ]; then
		# 服务器地址可能已变，清缓存让下次重新探测
		rm -f "$STATE_DIR/server"
		err "认证服务器 $ser:$PORTAL_PORT 无响应"
		set_error "认证服务器 $ser:$PORTAL_PORT 无响应"
		return 4
	fi

	if grep -q '"result":1[,}]' "$resp"; then
		log "认证成功 账号=$ACCOUNT 本机IP=$ip"
		return 0
	fi

	msg=$(sed -n 's/.*"msg":"\([^"]*\)".*/\1/p' "$resp" | head -1)
	[ -z "$msg" ] && msg=$(head -c 120 "$resp")
	err "认证失败：$msg (账号=$ACCOUNT IP=$ip)"
	set_error "认证失败：$msg"
	return 1
}

# 总开关停用时，手动动作也不要去动上行/认证，避免和 USB CPE 等其它上行打架
require_enabled() {
	[ "$ENABLED" = "1" ] && return 0
	err "插件已被总开关停用，忽略该操作"
	return 1
}

# 下线本机：暂停自动认证并断开上行。
# 校园网会话与接入点绑定，断开上行时 AC 会终止本机会话，且只影响这台设备。
do_offline() {
	require_enabled || return 0
	mkdir -p "$STATE_DIR" 2>/dev/null
	: > "$PAUSE_FILE"
	chmod 600 "$PAUSE_FILE" 2>/dev/null
	rm -f "$HOLD_FILE" 2>/dev/null

	local up
	up=$(resolve_uplink)
	log "下线本机：断开上行 $up"
	ifdown "$up" >/dev/null 2>&1
	do_sleep 2
	save_state 0 "-" "$up"
}

# 上线本机：拉起上行。控制在 20 秒内返回，避免界面请求超时；
# 残留的认证工作交给守护循环（这里顺手唤醒它，别让它睡满一个周期）。
do_online() {
	require_enabled || return 0
	rm -f "$PAUSE_FILE" 2>/dev/null
	clear_fails
	local up ip i=0
	up=$(resolve_uplink)
	log "上线本机：拉起上行 $up"
	ifup "$up" >/dev/null 2>&1

	while [ $i -lt 5 ]; do
		ip=$(iface_ip "$up")
		[ -n "$ip" ] && break
		do_sleep 2
		i=$((i+1))
	done

	if [ -z "$ip" ]; then
		err "上行 $up 尚未获取到 IP，交由守护继续处理"
		save_state 0 "-" "$up"
		do_wake
		return 3
	fi

	ensure_default_route "$up"

	if probe_online; then
		clear_error
		log "上线完成，无需重新认证"
		save_state 1 "$ip" "$up"
	else
		log "上行已恢复，等待守护完成认证"
		save_state 0 "$ip" "$up"
		do_wake
	fi

	return 0
}

# 立即重新认证（不碰接口，避免 ifup 带来的射频抖动）
do_relogin() {
	require_enabled || return 0
	local up ip
	rm -f "$PAUSE_FILE" 2>/dev/null
	clear_fails

	up=$(resolve_uplink)
	ip=$(iface_ip "$up")
	ensure_default_route "$up"

	if probe_online; then
		clear_error
		log "当前已在线，无需重新认证"
		save_state 1 "$ip" "$up"
		do_wake
		return 0
	fi

	log "重新认证"
	if do_login; then
		clear_fails
		clear_error
		do_sleep 3
	fi
	up=$(resolve_uplink)
	ip=$(iface_ip "$up")
	if probe_online; then save_state 1 "$ip" "$up"; else save_state 0 "$ip" "$up"; fi
	do_wake
}

do_status() {
	local up ip fails errmsg
	up=$(resolve_uplink)
	ip=$(iface_ip "$up")
	fails=$(get_fails)
	errmsg=$(cat "$ERR_FILE" 2>/dev/null)

	echo "上行接口: $up"
	echo "上行地址: ${ip:-未获取}"
	if ip route 2>/dev/null | grep -q '^default '; then
		echo "默认路由: 有"
	else
		echo "默认路由: 无（可能 netifd 与内核不同步，守护会尝试自动补回）"
	fi
	echo "账号:     ${ACCOUNT:-未配置}"
	echo "终端类型: $TERMINAL_TYPE"
	echo "认证服务器: $(server_cached):$PORTAL_PORT"
	[ -f "$PAUSE_FILE" ] && echo "自动认证: 已暂停（手动下线）"
	[ -f "$HOLD_FILE" ] && echo "自动认证: 已暂停（连续失败 $fails 次）"
	[ -n "$errmsg" ] && echo "最近错误: $errmsg"
	if probe_online 3; then echo "网络状态: 已认证，可上网"; else echo "网络状态: 未认证/无网络"; fi
}

# 唤醒守护进程立即重新检测（热插拔、手动上下线后调用），比整体重启服务轻得多
do_wake() {
	local pid
	pid=$(cat "$PID_FILE" 2>/dev/null)
	case "$pid" in
		''|*[!0-9]*) return 0 ;;
	esac
	kill -USR1 "$pid" 2>/dev/null || {
		log "唤醒失败：守护进程 $pid 不在了"
		return 1
	}
}

# 供 init.d 在「禁用/停止」时刷新一次状态，避免界面停留在过期快照
do_idle() {
	mkdir -p "$STATE_DIR" 2>/dev/null
	save_state 0 "-" "-"
}

on_stop() {
	[ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null
	rm -f "$PID_FILE" 2>/dev/null
	log "服务停止"
	save_state 0 "-" "-"
	exit 0
}

# 后台定时探测设备列表并写缓存：界面打开时直接读缓存，不用等 1 秒探测；
# 插拔网线也由这里统一刷新，而不是每次请求各探一次。
devwatch_loop() {
	LOG_TAG="[自动]"
	MIRROR_SYSLOG=0
	trap 'exit 0' TERM INT

	# 上次被强杀时可能留下临时文件，开工前清一次
	rm -f "$STATE_DIR"/.wl.* "$STATE_DIR"/.nb.* "$STATE_DIR"/.meta.* "$STATE_DIR"/.cand.* "$STATE_DIR"/devcache.tmp.* "$STATE_DIR"/.probe 2>/dev/null
	while true; do
		sh /usr/libexec/rpcd/drcom devprobe >/dev/null 2>&1
		do_sleep 5
	done
}

watch_loop() {
	# 守护循环自己写 syslog（procd 收集 stdout），标成「自动」，别再重复 logger
	LOG_TAG="[自动]"
	MIRROR_SYSLOG=0

	trap 'on_stop' TERM INT
	# USR1 只用来「戳醒」循环立即重新检测，不打日志，免得每次接口 ifup 都往 syslog 里写一行
	trap ':' USR1

	mkdir -p "$STATE_DIR" 2>/dev/null
	printf '%s\n' "$$" > "$PID_FILE"

	log "服务启动"
	[ -f "$PAUSE_FILE" ] && log "检测到手动下线标记，保持暂停状态"

	while true; do
		# 每轮重新读配置，界面上改完设置无需重启服务即可生效
		load_config

		if [ "$ENABLED" != "1" ]; then
			save_state 0 "-" "-"
			do_sleep 60
			continue
		fi

		if [ -z "$ACCOUNT" ] || [ -z "$PASSWORD" ]; then
			save_state 0 "-" "-"
			do_sleep 60
			continue
		fi

		local up ip
		up=$(resolve_uplink)
		ip=$(iface_ip "$up")
		if [ -z "$ip" ]; then
			save_state 0 "-" "$up"
			do_sleep 10
			continue
		fi

		# 内核缺默认路由时（netifd 不同步）先补回来，否则认证服务器永远不可达
		ensure_default_route "$up"

		# 用户手动下线后暂停自动认证，直到点「上线」或重启路由器（标记在 /etc，可跨重启）
		if [ -f "$PAUSE_FILE" ]; then
			if probe_online; then save_state 1 "$ip" "$up"; else save_state 0 "$ip" "$up"; fi
			do_sleep "$RETRY_INTERVAL"
			continue
		fi

		# 连续失败过多：不再自动重试，避免把账号撞到风控；网络自己恢复就自动解除
		if [ -f "$HOLD_FILE" ]; then
			if probe_online; then
				log "网络已恢复，解除失败暂停"
				clear_fails
				clear_error
				save_state 1 "$ip" "$up"
			else
				save_state 0 "$ip" "$up"
			fi
			do_sleep "$CHECK_INTERVAL"
			continue
		fi

		if probe_online; then
			clear_fails
			clear_error
			save_state 1 "$ip" "$up"
			do_sleep "$CHECK_INTERVAL"
			continue
		fi

		# 二次确认，避免瞬时抖动误判
		do_sleep 3
		if probe_online; then
			clear_fails
			clear_error
			save_state 1 "$ip" "$up"
			do_sleep "$CHECK_INTERVAL"
			continue
		fi

		# 上行 IP 变了就重新探测认证服务器
		if [ -f "$STATE_DIR/last_ip" ] && [ "$(cat "$STATE_DIR/last_ip")" != "$ip" ]; then
			rm -f "$STATE_DIR/server"
		fi
		printf '%s\n' "$ip" > "$STATE_DIR/last_ip"

		if do_login; then
			do_sleep 4
			if probe_online; then
				clear_fails
				clear_error
				save_state 1 "$ip" "$up"
				do_sleep "$CHECK_INTERVAL"
			else
				save_state 0 "$ip" "$up"
				set_error "认证接口返回成功，但网络仍未通"
				log "认证接口返回成功，但网络仍未通，稍后重试"
				bump_fail
				do_sleep "$(backoff_delay)"
			fi
		else
			save_state 0 "$ip" "$up"
			bump_fail
			do_sleep "$(backoff_delay)"
		fi
	done
}

load_config
detect_wget
mkdir -p "$STATE_DIR" 2>/dev/null

case "$1" in
	online)  do_online ;;
	offline) do_offline ;;
	login)   do_relogin ;;
	status)  do_status ;;
	watch)   watch_loop ;;
	devwatch) devwatch_loop ;;
	wake)    do_wake ;;
	idle)    do_idle ;;
	*) echo "用法: $0 {online|offline|login|status|watch|devwatch|wake|idle}"; exit 1 ;;
esac
