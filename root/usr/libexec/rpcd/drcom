#!/bin/sh
# luci-app-drcom 的 rpcd 后端：向 LuCI 界面提供状态与操作接口
. /usr/share/libubox/jshn.sh

STATE=/var/run/drcom/state
STATE_DIR=/var/run/drcom
META="$STATE_DIR/devmeta"	# mac type last_seen（记住设备是有线还是无线）
BLOCK=/etc/drcom.blocked	# 每行一个 MAC；只要不解除就一直阻断（关闭插件时清空）

# 取 uci 值；缺失时用和 drcom-portal 一致的默认值，
# 避免界面显示（例如「已禁用」）与运行时实际行为对不上。
cfg() {
	local v
	v=$(uci -q get "drcom.main.$1")
	if [ -n "$v" ]; then
		printf '%s' "$v"
	else
		printf '%s' "$2"
	fi
}

# ---------- 阻断相关 ----------

nft_table_init() {
	nft list table bridge drcom_block >/dev/null 2>&1 && return 0
	nft add table bridge drcom_block 2>/dev/null || return 1
	nft add set bridge drcom_block blocked '{ type ether_addr; }' 2>/dev/null || return 1
	nft add chain bridge drcom_block input '{ type filter hook input priority -10; policy accept; }' 2>/dev/null
	nft add chain bridge drcom_block forward '{ type filter hook forward priority -10; policy accept; }' 2>/dev/null
	# 只丢弃「单播」帧：广播（DHCP/ARP）照常放行，这样被断的设备还能重新关联并拿到 IP，
	# 保持"已连接但没网"的状态；这样点「解除」时可以立即恢复，不用等它重新连。
	nft 'add rule bridge drcom_block input ether saddr @blocked ether daddr != ff:ff:ff:ff:ff:ff drop' 2>/dev/null
	nft 'add rule bridge drcom_block forward ether saddr @blocked ether daddr != ff:ff:ff:ff:ff:ff drop' 2>/dev/null
	return 0
}

# 让内核里的阻断集合与 BLOCK 文件保持一致（文件为空就把表删掉，不留残留）
nft_sync_blocks() {
	local mac exp
	if [ ! -s "$BLOCK" ]; then
		nft list table bridge drcom_block >/dev/null 2>&1 && nft delete table bridge drcom_block 2>/dev/null
		return 0
	fi
	nft_table_init || return 1
	nft flush set bridge drcom_block blocked 2>/dev/null
	while read -r mac; do
		[ -n "$mac" ] && nft add element bridge drcom_block blocked "{ $mac }" 2>/dev/null
	done < "$BLOCK"
	return 0
}

# 兼容旧调用：现在没有过期时间，只剩「把文件里的 MAC 同步到内核」
block_purge() {
	nft_sync_blocks
}

# MAC 是否在阻断名单里 -> 输出 1，未阻断输出空
block_left() {
	grep -qx "$1" "$BLOCK" 2>/dev/null && echo 1
}

# ---------- 状态 ----------

method_status() {
	local running=0 online=0 paused=0 hold=0 fails=0 ip="" uplink="" account=""
	local stamp=0 age=-1 port ser term configured=0 enabled=1 last_error=""

	pgrep -f "drcom-portal watch" >/dev/null 2>&1 && running=1

	[ -f "$STATE" ] && . "$STATE"
	[ "$stamp" -gt 0 ] 2>/dev/null && age=$(( $(date +%s) - stamp ))

	port=$(cfg portal_port 801)
	term=$(cfg terminal_type 1)
	enabled=$(cfg enabled 1)

	# 认证服务器：优先用实际探测到的地址；没有缓存时回退到配置里的兜底 IP，
	# 否则界面会只剩一个「—」，看起来像配置丢了。
	ser=$(cat "$STATE_DIR/server" 2>/dev/null)
	[ -n "$ser" ] || ser=$(cfg portal_ip 172.22.44.46)

	[ -n "$(uci -q get drcom.main.username)" ] && [ -n "$(uci -q get drcom.main.password)" ] && configured=1

	json_init
	json_add_int    running    "$running"
	json_add_int    online     "$online"
	json_add_int    paused     "${paused:-0}"
	json_add_int    hold       "${hold:-0}"
	json_add_int    fails      "${fails:-0}"
	json_add_int    configured "$configured"
	json_add_string ip         "$ip"
	json_add_string uplink     "$uplink"
	json_add_string account    "$account"
	json_add_string server     "$ser"
	json_add_string port       "$port"
	json_add_string terminal   "$term"
	json_add_int    age        "$age"
	json_add_int    enabled    "$enabled"
	json_add_string last_error "${last_error:-}"
	json_dump
}

# ---------- 日志（自动认证 / 手动操作分开） ----------

method_log() {
	local pat
	case "$1" in
		op) pat='[操作]' ;;
		*)  pat='[自动]' ;;
	esac

	# 老版本启动日志末尾带「（连续失败 N 次后暂停自动重试）」，这句提示已经挪到界面里，显示时去掉
	logread -e drcom 2>/dev/null | grep -F "$pat" \
		| sed 's/（连续失败 [0-9][0-9]* 次后暂停自动重试）//' \
		| tail -n 80 > /tmp/.drcom-log.$$
	json_init
	json_add_array lines
	while IFS= read -r line; do
		json_add_string "" "$line"
	done < /tmp/.drcom-log.$$
	json_close_array
	rm -f /tmp/.drcom-log.$$
	json_dump
}

# ---------- 设备列表 ----------

# 找出所有 AP 模式接口上的 station -> "mac" 每行一个
list_stations() {
	local d
	for d in $(ls /sys/class/net 2>/dev/null); do
		[ -e "/sys/class/net/$d/phy80211" ] || continue
		iw dev "$d" info 2>/dev/null | grep -q 'type AP' || continue
		iw dev "$d" station dump 2>/dev/null \
			| sed -n 's/^Station \([0-9A-Fa-f:]*\).*/\1/p' \
			| tr 'A-F' 'a-f'
	done
}

method_devices() {
	local wl="$STATE_DIR/.wl" nb="$STATE_DIR/.nb" ne="$STATE_DIR/.meta.new"
	local landev mac ip host exp cid on wifi nip state left seen n=0 now

	now=$(date +%s)

	landev=$(uci -q get network.lan.device)
	[ -n "$landev" ] || landev=br-lan

	mkdir -p "$STATE_DIR" 2>/dev/null
	block_purge
	nft_sync_blocks

	list_stations > "$wl"

	# 邻居表：mac ip state（只要 IPv4，且跳过 FAILED —— 那表示已经探测不到了）
	ip neigh show dev "$landev" 2>/dev/null \
		| awk '{ if ($1 ~ /:/ || $NF == "FAILED") next;
			 ip = $1; mac = ""; for (i = 1; i <= NF; i++) if ($i == "lladdr") mac = $(i + 1);
			 if (mac != "") printf "%s %s %s\n", tolower(mac), ip, $NF }' > "$nb"

	: > "$ne"

	json_init
	json_add_array devices

	# 先按 DHCP 租约列出（有主机名）
	while read -r exp mac ip host cid; do
		[ -n "$mac" ] || continue
		mac=$(printf '%s' "$mac" | tr 'A-F' 'a-f')
		[ "$host" = "*" ] && host=""

		nip=$(awk -v m="$mac" '$1 == m { print $2; exit }' "$nb")
		[ -n "$nip" ] && ip="$nip"

		# 无线还是有线：当前在 station 列表里就是无线；否则沿用历史记录
		if grep -qx "$mac" "$wl" 2>/dev/null; then
			wifi=1
		else
			wifi=0
			case "$(awk -v m="$mac" '$1 == m { print $2; exit }' "$META" 2>/dev/null)" in
				w) wifi=1 ;;
			esac
		fi

		if [ "$wifi" = "1" ]; then
			# 无线设备以 station 是否存在为准：断开后立刻判定离线
			grep -qx "$mac" "$wl" 2>/dev/null && on=1 || on=0
		else
			state=$(awk -v m="$mac" '$1 == m { print $3; exit }' "$nb")
			case "$state" in
				REACHABLE|DELAY|PROBE) on=1 ;;
				*)
					# 邻居表是 STALE 或没有记录：发一个包触发 ARP 解析，再看状态
					# （主机若还在，ARP 会成功 -> REACHABLE；不在则 FAILED）
					ping -c 1 -W 1 "$ip" >/dev/null 2>&1
					state=$(ip neigh show "$ip" dev "$landev" 2>/dev/null | awk '{ print $NF }')
					case "$state" in
						REACHABLE|DELAY|PROBE) on=1 ;;
						*) on=0 ;;
					esac
					;;
			esac
		fi

		left=$(block_left "$mac")
		[ -n "$left" ] && on=0

		if [ "$on" = "1" ]; then
			seen=$now
		else
			seen=$(awk -v m="$mac" '$1 == m { print $3; exit }' "$META" 2>/dev/null)
			[ -n "$seen" ] || seen=0
		fi
		printf '%s %s %s\n' "$mac" "$( [ "$wifi" = 1 ] && echo w || echo e )" "$seen" >> "$ne"

		json_add_object
		json_add_string name      "$host"
		json_add_string ip        "$ip"
		json_add_string mac       "$mac"
		json_add_int    online    "$on"
		json_add_int    wireless  "$wifi"
		json_add_int    blocked   "$( [ -n "$left" ] && echo 1 || echo 0 )"
		json_add_string last_seen "$seen"
		json_close_object
		n=$((n + 1))
	done < /tmp/dhcp.leases

	# 再补上邻居表里有、但没有 DHCP 租约的设备（静态 IP）
	while read -r mac ip state; do
		[ -n "$mac" ] || continue
		grep -q "^$mac " "$ne" 2>/dev/null && continue
		wifi=0
		grep -qx "$mac" "$wl" 2>/dev/null && wifi=1
		case "$state" in
			REACHABLE|DELAY|PROBE) on=1 ;;
			*) on=0 ;;
		esac
		left=$(block_left "$mac")
		[ -n "$left" ] && on=0
		[ "$on" = "1" ] && seen=$now || seen=0
		printf '%s %s %s\n' "$mac" "$( [ "$wifi" = 1 ] && echo w || echo e )" "$seen" >> "$ne"
		json_add_object
		json_add_string name      ""
		json_add_string ip        "$ip"
		json_add_string mac       "$mac"
		json_add_int    online    "$on"
		json_add_int    wireless  "$wifi"
		json_add_int    blocked   "$( [ -n "$left" ] && echo 1 || echo 0 )"
		json_add_string last_seen "$seen"
		json_close_object
		n=$((n + 1))
	done < "$nb"

	json_close_array
	json_add_int count "$n"
	json_dump

	# 合并历史记录（暂时不在线的设备也要记住它是不是无线）
	if [ -f "$META" ]; then
		while read -r mac wifi seen; do
			[ -n "$mac" ] || continue
			grep -q "^$mac " "$ne" 2>/dev/null || printf '%s %s %s\n' "$mac" "$wifi" "$seen" >> "$ne"
		done < "$META"
	fi
	mv "$ne" "$META" 2>/dev/null
	chmod 600 "$META" 2>/dev/null

	rm -f "$wl" "$nb" 2>/dev/null
}

# ---------- 断开设备 ----------

# 读 rpcd 通过 stdin 传来的 JSON 参数（mac / 可选 ip）
read_params() {
	local req
	IFS= read -r req 2>/dev/null
	P_MAC=$(printf '%s' "$req" | jsonfilter -e '@.mac' 2>/dev/null | tr 'A-F' 'a-f')
	P_IP=$(printf '%s' "$req" | jsonfilter -e '@.ip' 2>/dev/null)
	case "$P_MAC" in
		''|*[!0-9a-f:]*) return 1 ;;
	esac
	return 0
}

# 清掉该设备已建立的连接。
# 本机开着 flow_offloading_hw，旧连接在硬件里转发、不经过 netfilter，
# 只加防火墙规则要等旧连接超时才断；删掉 conntrack（硬件表随之失效）才能立刻断。
flush_conntrack() {
	[ -n "$1" ] || return 0
	if ! command -v conntrack >/dev/null 2>&1; then
		# 没有 conntrack 工具时只能靠防火墙规则拦新连接，旧连接要等自己超时
		logger -t drcom-portal "[操作] 未安装 conntrack，已建立的连接不会立刻断开（新连接仍被阻断）" 2>/dev/null
		return 0
	fi
	conntrack -D -s "$1" >/dev/null 2>&1
	conntrack -D -d "$1" >/dev/null 2>&1
}

method_kick() {
	local mac ip
	read_params || { json_init; json_add_string message "无效的 MAC 地址"; json_dump; return; }
	mac="$P_MAC"
	ip="$P_IP"

	mkdir -p "$STATE_DIR" 2>/dev/null

	# 1) 先落阻断规则（只丢单播，广播放行，设备还能 DHCP / 保持关联）
	: > "$BLOCK.tmp"
	[ -f "$BLOCK" ] && awk -v m="$mac" '$1 != m' "$BLOCK" >> "$BLOCK.tmp"
	printf '%s\n' "$mac" >> "$BLOCK.tmp"
	mv "$BLOCK.tmp" "$BLOCK"
	chmod 600 "$BLOCK" 2>/dev/null
	nft_sync_blocks

	# 2) 清掉它的已有连接，旧连接立刻失效（不需要 deauth，设备保持关联，
	#    所以点「解除」时流量马上恢复）
	flush_conntrack "$ip"

	logger -t drcom-portal "[操作] 已阻断设备 $mac（直到手动解除）" 2>/dev/null

	json_init
	json_add_string message "已断开该设备，阻断持续到你点「解除」（或关闭插件）"
	json_dump
}

method_unkick() {
	local mac
	read_params || { json_init; json_add_string message "无效的 MAC 地址"; json_dump; return; }
	mac="$P_MAC"

	: > "$BLOCK.tmp"
	[ -f "$BLOCK" ] && awk -v m="$mac" '$1 != m' "$BLOCK" >> "$BLOCK.tmp"
	mv "$BLOCK.tmp" "$BLOCK"
	chmod 600 "$BLOCK" 2>/dev/null
	nft_sync_blocks
	logger -t drcom-portal "[操作] 已解除设备 $mac 的阻断" 2>/dev/null

	json_init
	json_add_string message "已解除阻断"
	json_dump
}

method_action() {
	local out
	case "$1" in
		online)  out=$(/usr/sbin/drcom-portal online 2>&1) ;;
		offline) out=$(/usr/sbin/drcom-portal offline 2>&1) ;;
		relogin) out=$(/usr/sbin/drcom-portal login 2>&1) ;;
		restart) /etc/init.d/drcom restart >/dev/null 2>&1; out="认证服务已重启" ;;
	esac
	json_init
	json_add_string message "$out"
	json_dump
}

# 总开关：整插件启用/停用。停用后守护进程不运行、不探测、不认证、不动上行接口，
# 方便接 USB CPE 等其它上行时避免两边互相抢。
method_master() {
	mkdir -p "$STATE_DIR" 2>/dev/null

	if [ "$1" = "on" ]; then
		uci -q set drcom.main.enabled='1'
		uci -q commit drcom
		/etc/init.d/drcom restart >/dev/null 2>&1
		logger -t drcom-portal "[操作] 插件已启用" 2>/dev/null
		json_init
		json_add_string message "插件已启用"
		json_dump
	else
		uci -q set drcom.main.enabled='0'
		uci -q commit drcom
		/etc/init.d/drcom stop >/dev/null 2>&1
		# 停用就不要再拦着任何设备了
		rm -f "$BLOCK"
		nft_sync_blocks
		logger -t drcom-portal "[操作] 插件已停用" 2>/dev/null
		json_init
		json_add_string message "插件已停用（不再探测、认证或改动上行接口）"
		json_dump
	fi
}

case "$1" in
	list)
		json_init
		json_add_object status;  json_close_object
		json_add_object log;     json_close_object
		json_add_object oplog;   json_close_object
		json_add_object devices; json_close_object
		json_add_object online;  json_close_object
		json_add_object offline; json_close_object
		json_add_object relogin; json_close_object
		json_add_object restart; json_close_object
		json_add_object kick;    json_close_object
		json_add_object unkick;  json_close_object
		json_add_object start;   json_close_object
		json_add_object stop;    json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)  method_status ;;
			log)     method_log auto ;;
			oplog)   method_log op ;;
			devices) method_devices ;;
			online)  method_action online ;;
			offline) method_action offline ;;
			relogin) method_action relogin ;;
			restart) method_action restart ;;
			kick)    method_kick ;;
			unkick)  method_unkick ;;
			start)   method_master on ;;
			stop)    method_master off ;;
			*) json_init; json_add_string message "unknown method"; json_dump ;;
		esac
		;;
	purge)
		# 供 drcom-portal 守护循环调用：清理到期的设备阻断并同步内核规则
		block_purge
		nft_sync_blocks
		;;
esac
