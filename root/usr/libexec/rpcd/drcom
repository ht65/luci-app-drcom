#!/bin/sh
# luci-app-drcom 的 rpcd 后端：向 LuCI 界面提供状态与操作接口
. /usr/share/libubox/jshn.sh

STATE=/var/run/drcom/state
STATE_DIR=/var/run/drcom
META="$STATE_DIR/devmeta"	# mac type last_seen（记住设备是有线还是无线）
BLOCK=/etc/drcom.blocked	# 每行一个 MAC；只要不解除就一直阻断（关闭插件时清空）

# 取 uci 值；缺失时用和 drcom-portal 一致的默认值，
# 避免界面显示（例如「已禁用」）与运行时实际行为对不上。
cfg() {
	local v
	v=$(uci -q get "drcom.main.$1")
	if [ -n "$v" ]; then
		printf '%s' "$v"
	else
		printf '%s' "$2"
	fi
}

# ---------- 阻断相关 ----------

# 初始化/修复 nft 表：幂等，表/集合/链/规则缺哪个补哪个。
# 之前只要表在就直接 return，若上次初始化中途失败（表建了、链或规则没建上），
# drop 规则就永远不会补上，阻断会静默失效。
NFT_ERR=""
nft_table_init() {
	NFT_ERR=""
	if ! nft list table bridge drcom_block >/dev/null 2>&1; then
		if ! nft add table bridge drcom_block 2>/dev/null; then
			NFT_ERR="当前固件不支持 nft bridge（缺少 bridge 家族支持），设备阻断不可用"
			logger -t drcom-portal "[操作] $NFT_ERR" 2>/dev/null
			return 1
		fi
	fi
	nft list set bridge drcom_block blocked >/dev/null 2>&1 \
		|| nft add set bridge drcom_block blocked '{ type ether_addr; }' 2>/dev/null
	nft list chain bridge drcom_block input >/dev/null 2>&1 \
		|| nft add chain bridge drcom_block input '{ type filter hook input priority -10; policy accept; }' 2>/dev/null
	nft list chain bridge drcom_block forward >/dev/null 2>&1 \
		|| nft add chain bridge drcom_block forward '{ type filter hook forward priority -10; policy accept; }' 2>/dev/null
	# 只丢弃「单播」帧：广播（DHCP/ARP）照常放行，这样被断的设备还能保持关联，
	# 解除后流量立刻恢复（不发 deauth 就是为了这个）。
	nft list chain bridge drcom_block input 2>/dev/null | grep -q 'ether saddr @blocked' \
		|| nft 'add rule bridge drcom_block input ether saddr @blocked ether daddr != ff:ff:ff:ff:ff:ff drop' 2>/dev/null
	nft list chain bridge drcom_block forward 2>/dev/null | grep -q 'ether saddr @blocked' \
		|| nft 'add rule bridge drcom_block forward ether saddr @blocked ether daddr != ff:ff:ff:ff:ff:ff drop' 2>/dev/null
	return 0
}

# 让内核里的阻断集合与 BLOCK 文件保持一致（文件为空就把表删掉，不留残留）
nft_sync_blocks() {
	local mac exp
	if [ ! -s "$BLOCK" ]; then
		nft list table bridge drcom_block >/dev/null 2>&1 && nft delete table bridge drcom_block 2>/dev/null
		return 0
	fi
	nft_table_init || return 1
	nft flush set bridge drcom_block blocked 2>/dev/null
	while read -r mac; do
		[ -n "$mac" ] && nft add element bridge drcom_block blocked "{ $mac }" 2>/dev/null
	done < "$BLOCK"
	return 0
}

# 兼容旧调用：现在没有过期时间，只剩「把文件里的 MAC 同步到内核」
block_purge() {
	nft_sync_blocks
}

# MAC 是否在阻断名单里 -> 在名单里输出 1，否则输出空
is_blocked() {
	grep -qx "$1" "$BLOCK" 2>/dev/null && echo 1
}

# ---------- 状态 ----------

method_status() {
	local running=0 online=0 paused=0 hold=0 fails=0 ip="" uplink="" account=""
	local stamp=0 age=-1 port ser term configured=0 enabled=1 last_error="" fail_max=5

	pgrep -f "drcom-portal watch" >/dev/null 2>&1 && running=1

	[ -f "$STATE" ] && . "$STATE"
	[ "$stamp" -gt 0 ] 2>/dev/null && age=$(( $(date +%s) - stamp ))

	port=$(cfg portal_port 801)
	term=$(cfg terminal_type 1)
	enabled=$(cfg enabled 1)
	fail_max=$(cfg fail_max 5)

	# 认证服务器：优先用实际探测到的地址；没有缓存时回退到配置里的兜底 IP，
	# 否则界面会只剩一个「—」，看起来像配置丢了。
	ser=$(cat "$STATE_DIR/server" 2>/dev/null)
	[ -n "$ser" ] || ser=$(cfg portal_ip 172.22.44.46)

	[ -n "$(uci -q get drcom.main.username)" ] && [ -n "$(uci -q get drcom.main.password)" ] && configured=1

	json_init
	json_add_int    running    "$running"
	json_add_int    online     "$online"
	json_add_int    paused     "${paused:-0}"
	json_add_int    hold       "${hold:-0}"
	json_add_int    fails      "${fails:-0}"
	json_add_int    configured "$configured"
	json_add_string ip         "$ip"
	json_add_string uplink     "$uplink"
	json_add_string account    "$account"
	json_add_string server     "$ser"
	json_add_string port       "$port"
	json_add_string terminal   "$term"
	json_add_int    age        "$age"
	json_add_int    enabled    "$enabled"
	json_add_string last_error "${last_error:-}"
	json_add_int    fail_max   "$fail_max"
	json_dump
}

# ---------- 日志（自动认证 / 手动操作分开） ----------

method_log() {
	local pat
	case "$1" in
		op) pat='[操作]' ;;
		*)  pat='[自动]' ;;
	esac

	# 老版本启动日志末尾带「（连续失败 N 次后暂停自动重试）」，这句提示已经挪到界面里，显示时去掉
	logread -e drcom 2>/dev/null | grep -F "$pat" \
		| sed 's/（连续失败 [0-9][0-9]* 次后暂停自动重试）//' \
		| tail -n 80 > /tmp/.drcom-log.$$
	json_init
	json_add_array lines
	while IFS= read -r line; do
		json_add_string "" "$line"
	done < /tmp/.drcom-log.$$
	json_close_array
	rm -f /tmp/.drcom-log.$$
	json_dump
}

# ---------- 设备列表 ----------

# 设备状态由后台定时探测写入缓存（drcom-portal devwatch），界面读缓存，
# 这样打开页面不用等 1 秒的探测，也避免多个请求并发跑同一套探测。
DEVCACHE="$STATE_DIR/devcache"
DEVCACHE_TS="$STATE_DIR/devcache.ts"
DEVCACHE_MAX_AGE=30

# 临时文件按进程号区分：否则两个并发请求会互相覆盖，出现「突然 0 台在线」
dev_tmp() {
	printf '%s/%s.%s' "$STATE_DIR" "$1" "$$"
}

# 有线设备的在线判定必须「主动探测」：网线拔掉后内核不会主动重验 ARP，
# 邻居表可能长时间停在 REACHABLE，只信这个状态就会出现「设备几分钟后才消失」。
# 所以每轮都对有线设备并发发一个包触发 ARP 重新解析（并发执行，整体约 1 秒）。

# 找出所有 AP 模式接口上的 station -> 每行一个 mac（无线设备在线判定的依据）
list_stations() {
	local d
	if ! command -v iw >/dev/null 2>&1; then
		# 没有 iw 时装不了无线客户端列表，所有设备会按「有线」显示；只提示一次
		if [ ! -f "$STATE_DIR/.noiw" ]; then
			logger -t drcom-portal "[操作] 未安装 iw，无法识别无线设备（会按有线显示）" 2>/dev/null
			: > "$STATE_DIR/.noiw" 2>/dev/null
		fi
		return 0
	fi
	for d in $(ls /sys/class/net 2>/dev/null); do
		[ -e "/sys/class/net/$d/phy80211" ] || continue
		iw dev "$d" info 2>/dev/null | grep -q 'type AP' || continue
		iw dev "$d" station dump 2>/dev/null \
			| sed -n 's/^Station \([0-9A-Fa-f:]*\).*/\1/p' \
			| tr 'A-F' 'a-f'
	done
}

collect_devices() {
	local wl nb ne cand landev mac ip host exp cid
	wl=$(dev_tmp .wl); nb=$(dev_tmp .nb); ne=$(dev_tmp .meta); cand=$(dev_tmp .cand)
	local on wifi nip state seen n=0 now blk name

	now=$(date +%s)
	landev=$(uci -q get network.lan.device)
	[ -n "$landev" ] || landev=br-lan
	mkdir -p "$STATE_DIR" 2>/dev/null

	block_purge
	list_stations > "$wl"

	# 邻居表：mac ip state（只要 IPv4，跳过 FAILED）
	ip neigh show dev "$landev" 2>/dev/null \
		| awk '{ if ($1 ~ /:/ || $NF == "FAILED") next;
			 ip = $1; mac = ""; for (i = 1; i <= NF; i++) if ($i == "lladdr") mac = $(i + 1);
			 if (mac != "") printf "%s %s %s\n", tolower(mac), ip, $NF }' > "$nb"

	: > "$cand"

	# 候选 1：DHCP 租约（带主机名）
	while read -r exp mac ip host cid; do
		[ -n "$mac" ] || continue
		mac=$(printf '%s' "$mac" | tr 'A-F' 'a-f')
		[ "$host" = "*" ] && host=""
		nip=$(awk -v m="$mac" '$1 == m { print $2; exit }' "$nb")
		[ -n "$nip" ] && ip="$nip"
		printf '%s|%s|%s\n' "$mac" "$host" "$ip" >> "$cand"
	done < /tmp/dhcp.leases

	# 候选 2：邻居表里有、但没有租约的设备（静态 IP）
	while read -r mac ip state; do
		[ -n "$mac" ] || continue
		grep -q "^$mac|" "$cand" 2>/dev/null && continue
		printf '%s|%s|%s\n' "$mac" "" "$ip" >> "$cand"
	done < "$nb"

	# 候选 3：还在阻断名单里、但上面都没列到的（保证界面上一定有点「解除」的入口）
	if [ -s "$BLOCK" ]; then
		while read -r mac; do
			[ -n "$mac" ] || continue
			grep -q "^$mac|" "$cand" 2>/dev/null && continue
			printf '%s|%s|%s\n' "$mac" "" "" >> "$cand"
		done < "$BLOCK"
	fi

	# 有线设备并发探一次（无线看 station 列表，不需要探；阻断中的也不探）
	while IFS='|' read -r mac name ip; do
		[ -n "$ip" ] || continue
		grep -qx "$mac" "$wl" 2>/dev/null && continue
		[ -n "$(is_blocked "$mac")" ] && continue
		ping -c 1 -W 1 "$ip" >/dev/null 2>&1 &
	done < "$cand"
	wait

	# 探测后再取一次邻居表（ping 已经触发 ARP 重新解析，状态才是最新的）
	ip neigh show dev "$landev" 2>/dev/null \
		| awk '{ if ($1 ~ /:/ || $NF == "FAILED") next;
			 ip = $1; mac = ""; for (i = 1; i <= NF; i++) if ($i == "lladdr") mac = $(i + 1);
			 if (mac != "") printf "%s %s %s\n", tolower(mac), ip, $NF }' > "$nb"

	json_init
	json_add_array devices
	: > "$ne"

	while IFS='|' read -r mac name ip; do
		[ -n "$mac" ] || continue

		# 无线还是有线：当前在 station 列表里就是无线，否则沿用历史记录
		wifi=0
		grep -qx "$mac" "$wl" 2>/dev/null && wifi=1
		if [ "$wifi" = "0" ]; then
			case "$(awk -v m="$mac" '$1 == m { print $2; exit }' "$META" 2>/dev/null)" in
				w) wifi=1 ;;
			esac
		fi

		blk=$(is_blocked "$mac")

		if [ -n "$blk" ]; then
			on=0
		elif [ "$wifi" = "1" ]; then
			# 无线设备以 station 是否存在为准
			grep -qx "$mac" "$wl" 2>/dev/null && on=1 || on=0
		else
			# 有线设备以「探测之后的 ARP 状态」为准：只有活跃状态才算在线
			state=$(awk -v m="$mac" '$1 == m { print $3; exit }' "$nb")
			case "$state" in
				REACHABLE|DELAY|PROBE) on=1 ;;
				*) on=0 ;;
			esac
		fi

		if [ "$on" = "1" ]; then
			seen=$now
		else
			seen=$(awk -v m="$mac" '$1 == m { print $3; exit }' "$META" 2>/dev/null)
			[ -n "$seen" ] || seen=0
		fi
		printf '%s %s %s\n' "$mac" "$( [ "$wifi" = 1 ] && echo w || echo e )" "$seen" >> "$ne"

		json_add_object
		json_add_string name      "$name"
		json_add_string ip        "$ip"
		json_add_string mac       "$mac"
		json_add_int    online    "$on"
		json_add_int    wireless  "$wifi"
		json_add_int    blocked   "$( [ -n "$blk" ] && echo 1 || echo 0 )"
		json_add_string last_seen "$seen"
		json_close_object
		n=$((n + 1))
	done < "$cand"

	json_close_array
	json_add_int count "$n"
	json_dump

	# 合并历史记录（暂时不在线的设备也要记住它是不是无线）
	if [ -f "$META" ]; then
		while read -r mac wifi seen; do
			[ -n "$mac" ] || continue
			grep -q "^$mac " "$ne" 2>/dev/null || printf '%s %s %s\n' "$mac" "$wifi" "$seen" >> "$ne"
		done < "$META"
	fi
	mv "$ne" "$META" 2>/dev/null
	chmod 600 "$META" 2>/dev/null

	# devmeta 只增不减会越积越多：超过 30 天没出现过的设备顺手清掉
	local prune
	prune=$(dev_tmp .meta.prune)
	awk -v n="$now" '$3 == 0 || $3 + 0 > n - 2592000' "$META" > "$prune" 2>/dev/null \
		&& mv "$prune" "$META" 2>/dev/null
	rm -f "$prune" 2>/dev/null

	rm -f "$wl" "$nb" "$cand" 2>/dev/null
}

# 探测一次并写缓存（由后台 devwatch 调用）
dev_probe_cache() {
	mkdir -p "$STATE_DIR" 2>/dev/null
	collect_devices > "$DEVCACHE.tmp.$$" 2>/dev/null
	if [ -s "$DEVCACHE.tmp.$$" ]; then
		mv "$DEVCACHE.tmp.$$" "$DEVCACHE"
		chmod 600 "$DEVCACHE" 2>/dev/null
		date +%s > "$DEVCACHE_TS"
		chmod 600 "$DEVCACHE_TS" 2>/dev/null
	else
		rm -f "$DEVCACHE.tmp.$$" 2>/dev/null
	fi
}

# 界面调用：优先用新鲜缓存（≤30 秒），否则现场探测一次
method_devices() {
	local ts age
	ts=$(cat "$DEVCACHE_TS" 2>/dev/null)
	case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
	age=$(( $(date +%s) - ts ))
	if [ -s "$DEVCACHE" ] && [ "$age" -lt "$DEVCACHE_MAX_AGE" ]; then
		cat "$DEVCACHE"
		return 0
	fi
	collect_devices
}

# ---------- 断开设备 ----------

# 读 rpcd 通过 stdin 传来的 JSON 参数（mac / 可选 ip）
read_params() {
	local req
	IFS= read -r req 2>/dev/null
	P_MAC=$(printf '%s' "$req" | jsonfilter -e '@.mac' 2>/dev/null | tr 'A-F' 'a-f')
	P_IP=$(printf '%s' "$req" | jsonfilter -e '@.ip' 2>/dev/null)
	case "$P_MAC" in
		''|*[!0-9a-f:]*) return 1 ;;
	esac
	return 0
}

# 名单读改写要串行（rpcd 不保证同一插件的调用顺序），用 flock 锁住
block_lock() {
	command -v flock >/dev/null 2>&1 || return 0
	exec 9>"$STATE_DIR/.block.lock" 2>/dev/null || return 0
	flock 9
	return 0
}

# 校验点分十进制 IPv4，合法则输出原值，否则输出空
valid_ipv4() {
	case "$1" in
		''|*[!0-9.]*) return 0 ;;
	esac
	printf '%s' "$1" | awk -F. '
		NF == 4 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ &&
		$1 + 0 <= 255 && $2 + 0 <= 255 && $3 + 0 <= 255 && $4 + 0 <= 255 { ok = 1 }
		END { exit !ok }' && printf '%s' "$1"
}

# 清掉该设备已建立的连接（IPv4 + 它现有的 IPv6 地址）。
# 本机开着 flow_offloading_hw，旧连接在硬件里转发、不经过 netfilter，
# 只加防火墙规则要等旧连接超时才断；删掉 conntrack（硬件表随之失效）才能立刻断。
# 返回：0=已清（或不需要清）；1=没有可用 IP；2=缺少 conntrack 工具
flush_conntrack() {
	local ip="$1" mac="$2" landev a
	command -v conntrack >/dev/null 2>&1 || return 2
	[ -n "$ip" ] || return 1

	conntrack -D -s "$ip" >/dev/null 2>&1
	conntrack -D -d "$ip" >/dev/null 2>&1

	landev=$(uci -q get network.lan.device)
	[ -n "$landev" ] || landev=br-lan
	for a in $(ip -6 neigh show dev "$landev" 2>/dev/null \
			| awk -v m="$mac" '{ for (i = 1; i <= NF; i++) if ($i == "lladdr") { if (tolower($(i + 1)) == m) print $1; break } }'); do
		conntrack -D -s "$a" >/dev/null 2>&1
		conntrack -D -d "$a" >/dev/null 2>&1
	done
	return 0
}

method_kick() {
	local mac ip tmp rc msg
	read_params || { json_init; json_add_string message "无效的 MAC 地址"; json_dump; return; }
	mac="$P_MAC"
	ip=$(valid_ipv4 "$P_IP")

	mkdir -p "$STATE_DIR" 2>/dev/null
	block_lock

	# 1) 先落阻断规则（只丢单播，广播放行，设备还能 DHCP / 保持关联）
	tmp="$BLOCK.tmp.$$"
	: > "$tmp"
	[ -f "$BLOCK" ] && awk -v m="$mac" '$1 != m' "$BLOCK" >> "$tmp"
	printf '%s\n' "$mac" >> "$tmp"
	mv "$tmp" "$BLOCK"
	chmod 600 "$BLOCK" 2>/dev/null

	nft_sync_blocks
	rc=$?

	# 2) 清掉它的已有连接，旧连接立刻失效（不需要 deauth，设备保持关联，
	#    所以点「解除」时流量马上恢复）
	flush_conntrack "$ip" "$mac"
	case "$?" in
		0) msg="已断开该设备，阻断持续到你点「解除」（或关闭插件）" ;;
		1) msg="已阻断该设备的新连接（没取到它的 IPv4，旧连接要等自己超时）" ;;
		2) msg="已阻断该设备的新连接（未装 conntrack，旧连接要等自己超时）" ;;
	esac
	[ "$rc" -ne 0 ] && msg="$NFT_ERR"

	logger -t drcom-portal "[操作] 阻断设备 $mac：$msg" 2>/dev/null

	json_init
	json_add_string message "$msg"
	json_dump
}

method_unkick() {
	local mac tmp
	read_params || { json_init; json_add_string message "无效的 MAC 地址"; json_dump; return; }
	mac="$P_MAC"

	mkdir -p "$STATE_DIR" 2>/dev/null
	block_lock

	tmp="$BLOCK.tmp.$$"
	: > "$tmp"
	[ -f "$BLOCK" ] && awk -v m="$mac" '$1 != m' "$BLOCK" >> "$tmp"
	if [ -s "$tmp" ]; then
		mv "$tmp" "$BLOCK"
		chmod 600 "$BLOCK" 2>/dev/null
	else
		# 名单空了就把文件也删掉，别留一个空文件
		rm -f "$tmp" "$BLOCK"
	fi
	nft_sync_blocks
	logger -t drcom-portal "[操作] 已解除设备 $mac 的阻断" 2>/dev/null

	json_init
	json_add_string message "已解除阻断"
	json_dump
}

method_action() {
	local out
	case "$1" in
		online)  out=$(/usr/sbin/drcom-portal online 2>&1) ;;
		offline) out=$(/usr/sbin/drcom-portal offline 2>&1) ;;
		relogin) out=$(/usr/sbin/drcom-portal login 2>&1) ;;
		restart) /etc/init.d/drcom restart >/dev/null 2>&1; out="认证服务已重启" ;;
	esac
	json_init
	json_add_string message "$out"
	json_dump
}

# 总开关：整插件启用/停用。停用后守护进程不运行、不探测、不认证、不动上行接口，
# 方便接 USB CPE 等其它上行时避免两边互相抢。
method_master() {
	mkdir -p "$STATE_DIR" 2>/dev/null

	if [ "$1" = "on" ]; then
		uci -q set drcom.main.enabled='1'
		uci -q commit drcom
		/etc/init.d/drcom restart >/dev/null 2>&1
		logger -t drcom-portal "[操作] 插件已启用" 2>/dev/null
		json_init
		json_add_string message "插件已启用"
		json_dump
	else
		uci -q set drcom.main.enabled='0'
		uci -q commit drcom
		/etc/init.d/drcom stop >/dev/null 2>&1
		# 停用就不要再拦着任何设备了
		rm -f "$BLOCK"
		nft_sync_blocks
		logger -t drcom-portal "[操作] 插件已停用" 2>/dev/null
		json_init
		json_add_string message "插件已停用（不再探测、认证或改动上行接口）"
		json_dump
	fi
}

case "$1" in
	list)
		json_init
		json_add_object status;  json_close_object
		json_add_object log;     json_close_object
		json_add_object oplog;   json_close_object
		json_add_object devices; json_close_object
		json_add_object online;  json_close_object
		json_add_object offline; json_close_object
		json_add_object relogin; json_close_object
		json_add_object restart; json_close_object
		json_add_object kick;    json_close_object
		json_add_object unkick;  json_close_object
		json_add_object start;   json_close_object
		json_add_object stop;    json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)  method_status ;;
			log)     method_log auto ;;
			oplog)   method_log op ;;
			devices) method_devices ;;
			online)  method_action online ;;
			offline) method_action offline ;;
			relogin) method_action relogin ;;
			restart) method_action restart ;;
			kick)    method_kick ;;
			unkick)  method_unkick ;;
			start)   method_master on ;;
			stop)    method_master off ;;
			*) json_init; json_add_string message "unknown method"; json_dump ;;
		esac
		;;
	purge)
		# 供 init.d / 守护进程调用：把 /etc/drcom.blocked 里的名单同步到内核
		block_purge
		;;
	devprobe)
		# 供后台 devwatch 调用：探测一次设备并刷新缓存
		dev_probe_cache
		;;
esac
