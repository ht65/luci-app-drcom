#!/bin/sh
# 上行接口（有线 wan / 无线中继 wwan）重新拨起时，唤醒守护进程立即重新检测。
# 这里只发信号、不整体重启服务：重启要走 procd 的停机流程，既慢又会打断状态更新。
[ "$ACTION" = "ifup" ] || exit 0

# 插件被总开关停用时什么都不做（例如改用 USB CPE 上行时，避免两边互相干扰）。
# 缺省（选项不存在）按「启用」处理，与 drcom-portal 的 config_get_bool 保持一致。
[ "$(uci -q get drcom.main.enabled)" != "0" ] || exit 0

# wan/wwan 是默认候选；如果用户把 uplink 改成了别的接口名，也要唤醒
uplink=$(uci -q get drcom.main.uplink)
case "$INTERFACE" in
	wan|wwan|"$uplink") /usr/sbin/drcom-portal wake ;;
esac
