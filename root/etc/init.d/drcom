#!/bin/sh /etc/rc.common
# Dr.COM 校园网认证服务：开机自启 + 断线自动重连

USE_PROCD=1
START=95
STOP=05

start_service() {
	config_load drcom
	config_get_bool enabled main enabled 1

	if [ "$enabled" != "1" ]; then
		logger -t drcom "插件已禁用，跳过启动"
		# 刷新一次状态，免得界面拿着一份过期快照显示「服务未运行」
		[ -x /usr/sbin/drcom-portal ] && /usr/sbin/drcom-portal idle >/dev/null 2>&1
		return 0
	fi

	procd_open_instance drcom
	procd_set_param command /usr/sbin/drcom-portal watch
	procd_set_param respawn 3600 5 0
	# 守护可能正阻塞在 wget（-T 8/12）上，默认 5 秒停机超时会在 TERM trap
	# 执行前 SIGKILL，导致状态不刷新、watch.pid 残留；放宽到足够覆盖一次请求。
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/drcom
	procd_close_instance

	# 设备列表缓存：每 5 秒探测一次并写缓存，界面直接读缓存（打开页面不用等探测）
	procd_open_instance devwatch
	procd_set_param command /usr/sbin/drcom-portal devwatch
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# 设备阻断是持久的（直到手动解除），重启后要把名单重新下发到内核
	[ -s /etc/drcom.blocked ] && sh /usr/libexec/rpcd/drcom purge >/dev/null 2>&1
}

stop_service() {
	# 故意不注销：本环境的注销是空转的，真正下线靠断开上行（见 drcom-portal offline）
	# 停止后刷新状态，避免界面停留在「已认证」
	[ -x /usr/sbin/drcom-portal ] && /usr/sbin/drcom-portal idle >/dev/null 2>&1
	:
}
