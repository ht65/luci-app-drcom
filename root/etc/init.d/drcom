#!/bin/sh /etc/rc.common
# Dr.COM 校园网认证服务：开机自启 + 断线自动重连

USE_PROCD=1
START=95
STOP=05

start_service() {
	config_load drcom
	config_get_bool enabled main enabled 1

	if [ "$enabled" != "1" ]; then
		logger -t drcom "插件已禁用，跳过启动"
		return 0
	fi

	procd_open_instance drcom
	procd_set_param command /usr/sbin/drcom-portal watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/drcom
	procd_close_instance
}

stop_service() {
	# 故意不注销：本环境的注销是空转的，真正下线靠断开上行（见 drcom-portal offline）
	:
}
